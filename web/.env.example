# Resend transactional email
# Verify the sending domain in Resend before using a non-onboarding address.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL="Guru Bulbs <hello@gurubulbs.com>"
RESEND_REPLY_TO_EMAIL=hello@gurubulbs.com

# Inbox for general contact enquiries.
RESEND_CONTACT_TO_EMAIL=hello@gurubulbs.com

# Inbox for dealership applications. Falls back to RESEND_CONTACT_TO_EMAIL if omitted.
RESEND_DEALERSHIP_TO_EMAIL=dealers@gurubulbs.com
